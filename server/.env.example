# Example settings for the Trendify API. Copy the values you need into your shell or your
# host's secret settings. NEVER commit real values: .env files are git-ignored.
#
# Development works with none of these set (APP_ENV defaults to development).

APP_ENV=production                 # development | production
SECRET_KEY=                        # python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=                    # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATABASE_URL=sqlite:///trendify.db # or postgresql://user:pass@host/db
CORS_ORIGINS=https://shop.example.com
FRONTEND_URL=https://shop.example.com
API_PUBLIC_URL=https://api.example.com
TRUSTED_PROXY_COUNT=1              # reverse proxies in front of the app (for client IPs / HTTPS)
RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Pesapal (https://developer.pesapal.com)
PAYMENT_PROVIDER=pesapal           # simulated is only allowed outside production
PESAPAL_ENV=sandbox                # sandbox | live
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=                    # optional; registered automatically and logged if empty
CURRENCY=USD

# Email (verification, password reset, alerts). Without MAIL_SERVER, emails are saved
# to instance/outbox/ instead of being sent.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Trendify <no-reply@example.com>
SECURITY_ALERT_EMAIL=security@example.com
